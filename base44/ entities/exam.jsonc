{
  "name": "Exam",
  "type": "object",
  "properties": {
    "subject": {
      "type": "string",
      "title": "Subject"
    },
    "course": {
      "type": "string",
      "title": "Course"
    },
    "semester": {
      "type": "number",
      "title": "Semester"
    },
    "department": {
      "type": "string",
      "title": "Department"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "start_time": {
      "type": "string",
      "title": "Start Time"
    },
    "end_time": {
      "type": "string",
      "title": "End Time"
    },
    "time_slot": {
      "type": "string",
      "enum": [
        "Morning (09:00-12:00)",
        "Afternoon (12:00-15:00)",
        "Evening (15:00-18:00)"
      ],
      "title": "Time Slot"
    },
    "required_invigilators": {
      "type": "number",
      "title": "Required Invigilators",
      "default": 2
    },
    "room_id": {
      "type": "string",
      "title": "Classroom ID"
    },
    "room_number": {
      "type": "string",
      "title": "Room Number"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "unassigned",
        "completed"
      ],
      "default": "unassigned"
    }
  },
  "required": [
    "subject",
    "course",
    "date",
    "start_time",
    "end_time",
    "required_invigilators"
  ]
}
